# 复制成 .env 后按需修改。所有值都有默认值，不建 .env 也能起（但请至少改掉数据库与 MinIO 密码）。
#
#   cp .env.example .env
#   docker compose up -d --build

# ---------- 应用端口 ----------
APP_PORT=9090

# ---------- 数据库 ----------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=video_studio
MYSQL_USER=vs
MYSQL_PASSWORD=vs123

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- 对象存储 ----------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=video-studio
# 官方 minio/minio 镜像已下架，默认用 pgsty 这个社区镜像
MINIO_IMAGE=pgsty/minio:latest

# ---------- 向量库 ----------
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091

# ---------- 大模型（留空 = 全离线运行）----------
# 任何兼容 OpenAI 协议的服务都行：DashScope、DeepSeek、vLLM、Ollama...
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 视觉描述：对 OCR 读不到文字的帧调用视觉模型，默认关闭（按帧计费）
VISION_CAPTION_ENABLED=false

# 实时语音/视频对话（可选）
REALTIME_API_KEY=

# whisper 模型地址；留空用镜像默认的 ggml-small.bin，首次启动自动下载到 /data/models
WHISPER_MODEL_URL=
